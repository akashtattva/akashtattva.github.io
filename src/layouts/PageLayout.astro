---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
// Frontmatter titles may contain inline HTML (e.g. <em> for italics).
// Render it as HTML in the heading, but strip tags for <title>/meta.
const stripTags = (s: string) => s.replace(/<[^>]*>/g, "");
---

<BaseLayout title={stripTags(frontmatter.title)} description={frontmatter.description}>
  <div class="page">
    <h1 set:html={frontmatter.title} />
    <slot />
  </div>
</BaseLayout>
