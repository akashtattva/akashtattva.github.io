---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Akash | Notes">
  <div class="index-content framed">
    <h1 id="hello-there">Hi, I am Akash. It’s a pleasure to have you here.</h1>
    <p>
      I am a design engineer and a creative technologist. This website is a
      place where I take notes. I like reading technical papers, technical blog
      posts a lot. My current interests roveolves around agent harnesses,
      scafolding, reinforcement learning (theory)
    </p>
    <p>
      If this interests you, I'd love to talk to you. Please drop a DM or send
      me an <a href="mailto:akash.popat27@gmail.com">email</a>.
    </p>
  </div>

  <div class="posts">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
