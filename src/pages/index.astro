---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Terminal">
  <div class="index-content framed">
    <h1 id="hello-there">Hi, I am Akash</h1>
    <p>Welcome to my notes.</p>
    <p>
      Here, I document my journey through various things I've learned about.
      Feel free to explore my notes and reach out if you have any questions or
      suggestions!
    </p>
  </div>

  <div class="posts">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
